rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // isManager() — MANAGER or SENIOR. Used for /users and /visits where a
    // Senior legitimately needs read access (e.g. viewing team members).
    function isManager() {
      return isVerified() && role() in ['MANAGER', 'SENIOR'];
    }

    // isStrictManager() — MANAGER only. Used for /assignments writes so that
    // only a Manager can assign / unassign employees, matching Android's
    // AuthRepositoryImpl which gates assignEmployeeToSenior behind MANAGER.
    function isStrictManager() {
      return isVerified() && role() == 'MANAGER';
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    // userExists() — checks the caller has a /users/{uid} document.
    // Copied verbatim from Android firestore.rules helper (line 12-14).
    // Used only in /assignments to mirror Android's read gate exactly.
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // ── /users/{uid} ─────────────────────────────────────────────────────────
    // • Any verified user can read their own document.
    // • Only managers can read any user document.
    // • Users can update their own profile fields (name, phone).
    // • No one can delete user documents via client SDK.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isManager();
      allow create: if isManager();
      allow update: if isOwner(uid) || isManager();
      allow delete: if false;
    }

    // ── /assignments/{assignmentId} ───────────────────────────────────────────
    // Mirrors Android firestore.rules lines 46–56 exactly.
    // Document ID format: {seniorId}_{employeeId}
    // Fields: seniorId (string), employeeId (string)
    //
    // Read:  caller must be signed-in AND have a /users document, AND be one of:
    //          • MANAGER (full collection access)
    //          • the Senior named in seniorId
    //          • the Employee named in employeeId
    // Write: MANAGER only.
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && userExists() && (
                    isStrictManager() ||
                    resource.data.seniorId   == request.auth.uid ||
                    resource.data.employeeId == request.auth.uid
                  );
      allow write: if isStrictManager();
    }

    // ── /visits/{visitId} ────────────────────────────────────────────────────
    // • Employees can create visits for themselves.
    // • Employees can read/update/delete only their own visits.
    // • Managers can read all visits, update any visit, never delete.
    //
    // Field name is "userId" — this is the field written by both the Android
    // app (VisitRepositoryImpl) and the web createVisit() service. It is also
    // the field used by subscribeToEmployeeVisits() where('userId', '==', uid).
    match /visits/{visitId} {
      allow create: if isVerified()
                    && request.resource.data.userId == request.auth.uid;

      allow read:   if isOwner(resource.data.userId) || isManager();

      allow update: if isOwner(resource.data.userId) || isManager();

      allow delete: if isOwner(resource.data.userId);
    }
  }
}
